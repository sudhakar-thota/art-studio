# Database connection string (SQLite by default for zero-friction local execution)
# You can easily swap this to PostgreSQL, Supabase, Neon, or PlanetScale
DATABASE_URL="file:./dev.db"

# JWT secret key for signing session tokens
JWT_SECRET="super-secret-jwt-token-replace-in-production"

# Next.js App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
